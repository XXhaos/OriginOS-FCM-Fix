<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application android:label="Guardian Autostart Probe">
        <activity
            android:name="io.github.originosfcmguardian.AutostartProbeActivity"
            android:exported="true"
            android:label="Guardian Autostart Probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="io.github.originosfcmguardian.AutostartProbeBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="Guardian Autostart Probe">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
