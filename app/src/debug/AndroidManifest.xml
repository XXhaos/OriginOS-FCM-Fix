<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".autoprotection.DebugProtectionLifecycleReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.originosfcmguardian.DEBUG_STOP_PROTECTION_SERVICE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".gmsheartbeat.DebugHeartbeatContinuityReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.originosfcmguardian.DEBUG_HEARTBEAT_REATTACH" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".autoprotection.DebugReadBenchmarkReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.originosfcmguardian.DEBUG_BENCHMARK_READS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
